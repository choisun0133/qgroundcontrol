<RCC>
    <qresource prefix="/fonts">
        <file alias="opensans">resources/fonts/OpenSans-Regular.ttf</file>
        <file alias="opensans-demibold">resources/fonts/OpenSans-Semibold.ttf</file>
        <file alias="NanumGothic-Regular">resources/fonts/NanumGothic-Regular.ttf</file>
        <file alias="NanumGothic-Bold">resources/fonts/NanumGothic-Bold.ttf</file>
    </qresource>
    <qresource prefix="/res">
        <file alias="BingNoTileBytes.dat">resources/BingNoTileBytes.dat</file>
        <file alias="CameraGimbal.png">resources/CameraGimbal.png</file>
        <file alias="chevron-double-right.svg">resources/chevron-double-right.svg</file>
        <file alias="GeoFence.svg">resources/GeoFence.svg</file>
        <file alias="QGCLogoArrow.svg">resources/QGCLogoArrow.svg</file>
        <file alias="AeroPower.svg">resources/AeroPower.svg</file>
        <file alias="AeroStartMission.svg">resources/AeroStartMission.svg</file>
        <file alias="AeroAI.svg">resources/AeroAI.svg</file>
        <file alias="AeroManualControl.svg">resources/AeroManualControl.svg</file>
        <file alias="AeroLockup.svg">resources/AeroLockup.svg</file>
        <file alias="AeroDroneLineArt.svg">resources/AeroDroneLineArt.svg</file>
        <file alias="AeroPayloadHookOpen.svg">resources/aero/payload/HookOpen.svg</file>
        <file alias="AeroPayloadHookClose.svg">resources/aero/payload/HookClose.svg</file>
        <file alias="AeroPayloadLineUp.svg">resources/aero/payload/LineUp.svg</file>
        <file alias="AeroPayloadLineStop.svg">resources/aero/payload/LineStop.svg</file>
        <file alias="AeroPayloadLineDown.svg">resources/aero/payload/LineDown.svg</file>
        <file alias="AeroPayloadGripperGrab.svg">resources/aero/payload/GripperGrab.svg</file>
        <file alias="AeroPayloadGripperRelease.svg">resources/aero/payload/GripperRelease.svg</file>
        <file alias="AeroPayloadGripperGrabActive.svg">resources/aero/payload/GripperGrabActive.svg</file>
        <file alias="AeroPayloadGripperReleaseActive.svg">resources/aero/payload/GripperReleaseActive.svg</file>
        <file alias="rtl.svg">resources/rtl.svg</file>
        <file alias="SplashScreen">resources/SplashScreen.png</file>
        <file alias="takeoff.svg">resources/takeoff.svg</file>
        <file alias="TrashCan.svg">resources/TrashCan.svg</file>
        <file alias="TrashDelete.svg">resources/TrashDelete.svg</file>
        <file alias="XDelete.svg">resources/XDelete.svg</file>
    </qresource>
</RCC>
